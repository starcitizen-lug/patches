From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jack Greiner <jack@emoss.org>
Date: Mon, 27 Jul 2026 17:15:00 -0400
Subject: [PATCH] ntdll: Cache memory info to improve performance.

Star Citizen profiles every Wwise allocation, so VirtualQuery is called thousands of
times a second and the get_vprot_range_size() walk in get_committed_size() becomes a
bottleneck, made worse by EAC hooking the APIs the profiler calls along the way.

Cache the extent of the uniform-protection run each query resolves. Any later query
landing inside that run is answered without walking the page table: every page in a
run shares one masked protection byte and the run ends at the same address wherever
it is entered, so the cached answer is identical to the one the scan would produce.

The run is validated against a generation counter bumped whenever a page protection
byte changes, rather than a wall-clock window, so a commit, decommit or protection
change can never be served a stale region size or state. VPROT_WRITEWATCH is exempt
from the bump since it is masked out of the run comparison and no field of
MEMORY_BASIC_INFORMATION derives from it. VPROT_COPIED is not exempt: get_win32_prot()
reads it, and it falls inside the mask, so runs already break on it.
---
 dlls/ntdll/unix/virtual.c | 71 +++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 62 insertions(+), 9 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index d5b93415c2a..da127590942 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -253,6 +253,13 @@ struct file_view
     void         *base;          /* base address */
     size_t        size;          /* size in bytes */
     unsigned int  protect;       /* protection for all pages at allocation time and SEC_* flags */
+    /* Cached result of the last fill_basic_memory_info() page table walk over this view.
+     * Star Citizen profiles every Wwise allocation, which drives VirtualQuery thousands of
+     * times a second and makes the get_vprot_range_size() scan a bottleneck. */
+    char              *query_run_start;  /* first page of the cached uniform protection run */
+    char              *query_run_end;    /* end of that run, NULL when the cache is empty */
+    unsigned long long query_run_gen;    /* value of vprot_gen when the run was computed */
+    BYTE               query_run_vprot;  /* protection byte shared by every page in the run */
 };
 
 /* per-page protection flags */
@@ -1330,6 +1337,12 @@ static SIZE_T get_vprot_range_size( char *base, SIZE_T size, BYTE mask, BYTE *vp
     return size;
 }
 
+/* Bumped whenever a page protection byte changes in a way that can move the run
+ * boundaries get_vprot_range_size() reports. VPROT_WRITEWATCH is exempt: it is masked
+ * out of the run comparison and no MEMORY_BASIC_INFORMATION field derives from it.
+ * Guarded by virtual_mutex along with the page table itself. */
+static unsigned long long vprot_gen = 1;
+
 /***********************************************************************
  *           set_page_vprot
  *
@@ -1340,6 +1353,7 @@ static void set_page_vprot( const void *addr, size_t size, BYTE vprot )
     size_t idx = (size_t)addr >> page_shift;
     size_t end = ((size_t)addr + size + page_mask) >> page_shift;
 
+    vprot_gen++;
 #ifdef _WIN64
     while (idx >> pages_vprot_shift != end >> pages_vprot_shift)
     {
@@ -1364,6 +1378,10 @@ static void set_page_vprot_bits( const void *addr, size_t size, BYTE set, BYTE c
     size_t idx = (size_t)addr >> page_shift;
     size_t end = ((size_t)addr + size + page_mask) >> page_shift;
 
+    /* Software write watch toggles VPROT_WRITEWATCH constantly. Leaving the generation
+     * alone for it keeps those updates from flushing the query cache. */
+    if ((set | clear) & ~VPROT_WRITEWATCH) vprot_gen++;
+
 #ifdef _WIN64
     for ( ; idx < end; idx++)
     {
@@ -1832,20 +1850,29 @@ static void unmap_area( void *start, size_t size )
  */
 static struct file_view *alloc_view(void)
 {
+    struct file_view *ret;
+
     if (next_free_view)
     {
-        struct file_view *ret = next_free_view;
+        ret = next_free_view;
         next_free_view = *(struct file_view **)ret;
-        return ret;
     }
-    if (view_block_start == view_block_end)
+    else
     {
-        void *ptr = anon_mmap_alloc( view_block_size, PROT_READ | PROT_WRITE );
-        if (ptr == MAP_FAILED) return NULL;
-        view_block_start = ptr;
-        view_block_end = view_block_start + view_block_size / sizeof(*view_block_start);
+        if (view_block_start == view_block_end)
+        {
+            void *ptr = anon_mmap_alloc( view_block_size, PROT_READ | PROT_WRITE );
+            if (ptr == MAP_FAILED) return NULL;
+            view_block_start = ptr;
+            view_block_end = view_block_start + view_block_size / sizeof(*view_block_start);
+        }
+        ret = view_block_start++;
     }
-    return view_block_start++;
+    /* free_view() only overwrites the first pointer of the struct, so a recycled view
+     * still carries the previous occupant's cached run. Clear it here rather than in
+     * create_view(), which remove_pages_from_view() bypasses. */
+    ret->query_run_start = ret->query_run_end = NULL;
+    return ret;
 }
 
 
@@ -2729,6 +2756,10 @@ static NTSTATUS remove_pages_from_view( struct file_view *view, char *base, size
 {
     assert( size < view->size );
 
+    /* The view is about to be resized, so a run cached against its old extent could
+     * reach past the new end. */
+    view->query_run_start = view->query_run_end = NULL;
+
     if (view->base != base && base + size != (char *)view->base + view->size)
     {
         struct file_view *new_view = alloc_view();
@@ -2891,6 +2922,7 @@ static NTSTATUS coalesce_placeholders( struct file_view *view, char *base, size_
     }
 
     unregister_view( view );
+    view->query_run_start = view->query_run_end = NULL;
     view->size = views_size;
     register_view( view );
 
@@ -6065,7 +6097,28 @@ static unsigned int fill_basic_memory_info( const void *addr, MEMORY_BASIC_INFOR
         BYTE vprot;
 
         info->AllocationBase = alloc_base;
-        info->RegionSize = get_committed_size( view, base, ~(size_t)0, &vprot, ~VPROT_WRITEWATCH );
+        if (view->query_run_gen == vprot_gen && base >= view->query_run_start && base < view->query_run_end)
+        {
+            /* Every page in the run shares one masked protection byte, and the run ends at
+             * the same address wherever it is entered, so this is the answer the scan would
+             * have produced. get_win32_prot() and the State test below only read bits that
+             * the ~VPROT_WRITEWATCH mask compares, so the whole run maps to one result. */
+            info->RegionSize = view->query_run_end - base;
+            vprot = view->query_run_vprot;
+        }
+        else
+        {
+            info->RegionSize = get_committed_size( view, base, ~(size_t)0, &vprot, ~VPROT_WRITEWATCH );
+            /* SEC_RESERVE sizes come from the server and can change with no local
+             * protection change, so vprot_gen cannot vouch for them. */
+            if (!(view->protect & SEC_RESERVE))
+            {
+                view->query_run_start = base;
+                view->query_run_end   = base + info->RegionSize;
+                view->query_run_vprot = vprot;
+                view->query_run_gen   = vprot_gen;
+            }
+        }
         info->State = (vprot & VPROT_COMMITTED) ? MEM_COMMIT : MEM_RESERVE;
         info->Protect = (vprot & VPROT_COMMITTED) ? get_win32_prot( vprot, view->protect ) : 0;
         info->AllocationProtect = get_win32_prot( view->protect, view->protect );
-- 
2.52.0

